# Copy this file to .env and fill in the values you need.
# Never commit the real .env - it's already gitignored.

# --- Required for the chat feature (chat_backend.py) ---
# OpenRouter API key, https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the free-tier model used for chat. Check
# https://openrouter.ai/models?max_price=0 for the current free lineup
# (the default below may go stale as OpenRouter's free tier changes).
OPENROUTER_MODEL=minimax/minimax-m3:free

# --- Optional: the generate_activity_video MCP tool (server.py) ---
# Base URL of a self-hosted Cosmos3-Nano vLLM-Omni server. Only needed if you
# use that tool; it's skipped otherwise.
COSMOS_BASE_URL=http://localhost:8000

# --- Optional: only used by the standalone MCP demo client (client.py) ---
# AsyncOpenAI() reads these directly; not used by the web app / chat_backend.py.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
