# Copy this file to .env and fill in the values you need.
# Never commit the real .env - it's already gitignored.

# --- Required for chat (both client.py and the web app's chat_backend.py) ---
# AsyncOpenAI() reads these directly. Point them at any OpenAI-compatible
# provider - Mistral (https://api.mistral.ai/v1), OpenRouter
# (https://openrouter.ai/api/v1), OpenAI itself, etc. The model just needs
# to support OpenAI-style tool/function calling, since chat_backend.py uses
# it to call this repo's MCP tools.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: the generate_activity_video MCP tool (server.py) ---
# Base URL of a self-hosted Cosmos3-Nano vLLM-Omni server. Only needed if you
# use that tool; it's skipped otherwise.
COSMOS_BASE_URL=http://localhost:8000
